.tag{font-size:.6rem;padding:2px 6px;border-radius:4px;background:rgba(234,179,8,.15);color:var(--gold2);font-weight:700}
.fbtn{display:block;width:100%;margin:0 auto 18px;padding:9px 14px;border-radius:12px;background:rgba(234,179,8,.1);border:1px solid rgba(234,179,8,.35);color:var(--gold2);font-size:.74rem;font-weight:700;cursor:pointer;text-align:center}
h2{font-size:.82rem;font-weight:800;color:var(--gold2);text-transform:uppercase;letter-spacing:.5px;margin:16px 0 10px}
.lev{background:var(--card);border-radius:14px;padding:13px;margin-bottom:10px;border:1px solid rgba(255,255,255,.07);border-left:4px solid var(--gold)}
.lev.r{border-left-color:#ef4444}.lev.g{border-left-color:var(--emerald)}
