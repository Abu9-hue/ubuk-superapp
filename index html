.face{position:absolute;inset:0;backface-visibility:hidden;border-radius:18px;padding:18px;border:1px solid rgba(234,179,8,.5);display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 12px 30px rgba(0,0,0,.5)}
