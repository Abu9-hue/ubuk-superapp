<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>UBUK.NET — Latif Connect Framework</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background-color:#050b12;background-image:radial-gradient(circle at 50% 45%,rgba(212,175,55,.12),transparent 60%),repeating-radial-gradient(circle at 50% 50%,transparent 0,transparent 28px,rgba(212,175,55,.07) 29px,rgba(14,55,82,.15) 31px);color:#f8fafc;min-height:100vh;overflow-x:hidden}
.wrap{max-width:1280px;margin:0 auto;padding:12px}
.top-head{text-align:center;margin-bottom:12px}
.top-head h1{color:#f3d46e;font-size:clamp(1.6rem,3.5vw,2.3rem);letter-spacing:3px;font-weight:900}
.top-head .sub{color:#d4af37;font-size:.75rem;letter-spacing:2px;text-transform:uppercase}
.grid-main{display:grid;grid-template-columns:270px 1fr 270px;gap:14px;align-items:stretch}
@media(max-width:960px){.grid-main{grid-template-columns:1fr}}
.side-col{display:flex;flex-direction:column;justify-content:space-between;gap:14px}
.kpi-box{background:rgba(8,17,28,.88);border:1px solid rgba(212,175,55,.35);border-radius:14px;padding:12px;backdrop-filter:blur(6px)}
.kpi-head{display:flex;justify-content:space-between;font-size:.78rem;font-weight:800;color:#e2e8f0;margin-bottom:8px;border-bottom:1px solid rgba(255,255,255,.08);padding-bottom:5px}
.kpi-head span{color:#10b981}
.bars{display:flex;align-items:flex-end;gap:4px;height:54px;margin-bottom:8px}
.bars i{flex:1;background:linear-gradient(180deg,#f3d46e,#b45309);border-radius:2px 2px 0 0;display:block}
.hbars{display:grid;gap:5px;margin-bottom:8px}
.hbar{display:flex;align-items:center;gap:6px;font-size:.65rem;color:#94a3b8}
.hbar div{flex:1;height:6px;background:#1e293b;border-radius:4px;overflow:hidden}
.hbar span{display:block;height:100%;background:linear-gradient(90deg,#10b981,#f3d46e)}
.kpi-nums{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;text-align:center;font-size:.75rem}
.kpi-nums b{display:block;color:#fff;font-size:.88rem}
.kpi-nums small{color:#94a3b8;font-size:.62rem}
.center-stage{display:flex;flex-direction:column;align-items:center;justify-content:space-between;position:relative;padding:4px 0}
.btn-app{background:linear-gradient(135deg,#10b981,#047857);color:#fff;text-decoration:none;font-weight:800;font-size:.95rem;padding:13px 26px;border-radius:12px;border:1px solid #34d399;box-shadow:0 0 24px rgba(16,185,129,.45);display:inline-flex;align-items:center;gap:10px;margin-bottom:18px;transition:.2s}
.btn-app:hover{transform:scale(1.03)}
.arena{position:relative;width:100%;min-height:410px;display:grid;grid-template-columns:138px 1fr 138px;grid-template-rows:1fr 1fr;gap:28px 10px;align-items:center}
@media(max-width:600px){.arena{grid-template-columns:1fr 1fr;min-height:auto;gap:34px 12px}.globe-wrap{grid-column:1/-1;order:-1;margin:10px auto 24px}}
.benef-slot{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center}
.pill-top{position:absolute;top:-22px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.1);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.25);color:#f8fafc;font-size:.66rem;font-weight:800;letter-spacing:1px;padding:2px 10px;border-radius:999px;white-space:nowrap}
.card-p{width:132px;background:rgba(10,20,32,.92);border:1px solid rgba(212,175,55,.45);border-radius:12px;overflow:hidden;position:relative;box-shadow:0 8px 20px rgba(0,0,0,.6)}
.num-badge{position:absolute;top:5px;right:6px;background:rgba(5,11,18,.8);color:#f3d46e;font-weight:900;font-size:.75rem;padding:1px 6px;border-radius:6px;border:1px solid #d4af37;z-index:3}
.num-wm{position:absolute;top:24px;left:8px;font-size:2.4rem;font-weight:900;color:rgba(243,212,110,.22);pointer-events:none;z-index:2}
.avatar-box{height:105px;background:linear-gradient(180deg,#1e293b,#0f172a);display:flex;align-items:center;justify-content:center;font-size:2.6rem}
.p-info{padding:6px 8px;font-size:.72rem;background:#071019;border-top:1px solid rgba(212,175,55,.25)}
.p-info strong{display:block;color:#fff;font-size:.76rem}
.p-info span{color:#cbd5e1;font-size:.67rem}
.globe-wrap{grid-column:2;grid-row:1/3;position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:scale(1.12)}
#globeCanvas{border-radius:50%;box-shadow:0 0 45px var(--glow,#f59e0b),inset -18px -18px 35px rgba(0,0,0,.85);transition:box-shadow .6s ease}
.orbit-news{margin-top:-18px;background:rgba(5,11,18,.92);border:1.5px solid var(--glow,#f59e0b);color:#fff;padding:5px 14px;border-radius:999px;font-size:.72rem;font-weight:700;letter-spacing:.5px;box-shadow:0 4px 16px rgba(0,0,0,.7);text-align:center;max-width:340px;transition:border-color .6s ease}
.rainbow-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;width:100%;max-width:460px;margin-top:22px;z-index:5}
.r-btn{border:none;border-radius:10px;padding:10px 8px;font-size:.74rem;font-weight:800;color:#fff;cursor:pointer;text-transform:uppercase;letter-spacing:.4px;box-shadow:0 4px 12px rgba(0,0,0,.45);transition:.2s;text-align:center}
.r-btn:hover{transform:translateY(-2px);filter:brightness(1.1)}
.c-red{background:linear-gradient(135deg,#dc2626,#991b1b)}
.c-orange{background:linear-gradient(135deg,#ea580c,#9a3412)}
.c-yellow{background:linear-gradient(135deg,#eab308,#a16207);color:#07111a}
.c-blue{background:linear-gradient(135deg,#2563eb,#1e40af)}
.c-indigo{background:linear-gradient(135deg,#4f46e5,#3730a3)}
.c-violet{background:linear-gradient(135deg,#9333ea,#6b21a8)}
.page-modal{display:none;position:fixed;inset:0;background:#050b12;z-index:999;overflow-y:auto;padding:18px}
.page-modal.open{display:block}
.modal-inner{max-width:960px;margin:0 auto;background:#0b1726;border:1px solid #d4af37;border-radius:16px;padding:20px}
.modal-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(212,175,55,.3);padding-bottom:12px;margin-bottom:16px}
.btn-retour{background:#10b981;color:#fff;border:none;padding:9px 16px;border-radius:10px;font-weight:800;cursor:pointer}
</style>
</head>
