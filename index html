.fido{width:100%;padding:10px;border-radius:10px;background:rgba(16,185,129,.08);border:1px solid var(--emerald);color:#fff;font-size:.73rem;font-weight:700;cursor:pointer}
.inp,.sel{width:100%;padding:10px;border-radius:10px;background:#05080f;border:1px solid rgba(255,255,255,.15);color:#fff;font-size:.78rem}
.go{background:linear-gradient(135deg,var(--gold),#ca8a04);color:#05080f;font-weight:800;border:none;border-radius:10px;padding:11px;width:100%;font-size:.8rem;cursor:pointer}
.go:disabled{opacity:.6;cursor:not-allowed}
.res{margin-top:10px;padding:10px;border-radius:10px;background:rgba(16,185,129,.12);border:1px solid var(--emerald);font-size:.74rem;display:none}
.acc{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:10px;padding:10px 12px;margin-bottom:8px}
.acc strong{color:var(--gold2)}.hid{display:none}
</style>
</head>
